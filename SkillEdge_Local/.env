# SkillEdge / Manager OS — environment configuration
# Copy to .env and fill values. In development, backend/api/config.py
# uses built-in fallbacks; in production (SKILLEDGE_ENV=production) every
# RMS credential below is REQUIRED or startup fails.

# ── Runtime ──
SKILLEDGE_ENV=development           # development | production
SKILLEDGE_PORT=8765
SKILLEDGE_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
SKILLEDGE_LOG_FORMAT=text           # text | json

# ── RMS API credentials (user/pass pairs) ──
SKILLEDGE_RMS_ASSIGNMENTS_PASS=
SKILLEDGE_RMS_ASSIGNMENTS_USER=
SKILLEDGE_RMS_COURSE_LIST_PASS=
SKILLEDGE_RMS_COURSE_LIST_USER=
