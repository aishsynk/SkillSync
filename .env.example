# SkillEdge Backend (backend.py) — environment configuration
#
# Copy to .env and fill in values. In development, fallback defaults
# in _APIS allow local dev without RMS access. In production
# (SKILLEDGE_ENV=production), every RMS credential below is REQUIRED
# — if unset, _validate_credentials() logs a loud warning at startup.
#
# Once all env vars are confirmed set on the production host, the
# hardcoded fallbacks in backend.py:_APIS will be removed.

# ── Runtime ────────────────────────────────────────────────────────────────
SKILLEDGE_ENV=development
SKILLEDGE_PORT=8765

# ── Aishwar international-demand rule (exact account opt-in) ──────────────
# Empty string disables the rule.
SKILLEDGE_AISHWAR_INTERNATIONAL_RULE_EMAIL=aishwar_v@koenig-solutions.com

# ── RMS API credentials (user/pass pairs) ─────────────────────────────────
# Active APIs (called by at least one route):
