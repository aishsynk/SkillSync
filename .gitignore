# SkillEdge .gitignore

# Environment and secrets
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo

# Runtime artifacts (regenerated at run time)
/runtime/cache/
/runtime/logs/
/backend/data/
# legacy locations (pre-restructure)
.cache/
logs/
*.log

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store
