<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Pre-Compose window theme. Transparent system bars let the app draw
      edge-to-edge; the window background matches the login screen so there is
      no white flash between the launcher and first frame.
    -->
    <style name="Theme.SkillSync" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
